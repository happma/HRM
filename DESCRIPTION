Package: HRM
Version: 1.3.0
Date: 2026-08-31
Title: High-Dimensional Repeated Measures
Authors@R: c(person("Martin", "Happ", role = c("aut", "cre"),
                      email = "statistics@happ.co.at",
                      comment = c(ORCID = "0000-0003-0009-2665")),
	      person("Solomon W.", "Harrar", role = "aut"),
